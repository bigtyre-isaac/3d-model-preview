:80 {
    root * {$PUBLIC_ROOT:/srv}
    encode zstd gzip
    # Uploaded files are data, including when someone uploads HTML or SVG.
    header /models/* {
        Content-Disposition attachment
        X-Content-Type-Options nosniff
        Content-Security-Policy sandbox
    }
    route {
        # Models keep their persistent mount when development pages come from source.
        handle /models/* {
            root * /srv
            file_server {
                hide /srv/models/.upload-*
            }
        }
        handle /api/* {
            reverse_proxy 127.0.0.1:3000
        }
        @uploadPost {
            path /upload
            method POST
        }
        handle @uploadPost {
            reverse_proxy 127.0.0.1:3000
        }
        handle /upload {
            rewrite * /upload.html
            file_server
        }
        handle /account {
            rewrite * /account.html
            file_server
        }
        handle {
            file_server {
                hide /srv/models/.upload-*
            }
        }
    }
}
