PORT=8090
APP_ORIGIN=http://localhost:8090
# Local HTTP only; use true with HTTPS in production.
COOKIE_SECURE=false
ADMIN_USERNAME=admin
# Creates the first admin, or resets ADMIN_USERNAME on every startup when supplied.
# Use at least 12 characters; remove after startup to stop reapplying the password.
ADMIN_PASSWORD=
# Alternatively supply a mounted secret file inside the container (takes precedence).
ADMIN_PASSWORD_FILE=
AUTH_DIR=./auth-data
